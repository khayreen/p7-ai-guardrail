# Copy to .env and fill in. Never commit .env.

# Upstream model for POST /v1/chat: groq | gemini | openrouter | ollama | echo
# "echo" needs no key and simply repeats the (masked) message back.
LLM_PROVIDER=echo
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL=

# Require this key in the X-API-Key header on every call (recommended).
# SERVICE_API_KEY=

# Block at the flag threshold instead of only flagging.
# STRICT_MODE=true

# Comma-separated domains that may appear as links in model output.
# ALLOWED_LINK_DOMAINS=bankcontoh.example

# Where decisions are recorded.
# AUDIT_LOG=audit.jsonl
